<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ControlGastos.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ControlGastos.Views"
       Title="Control de Gastos"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Gastos"
                      Route="gastos"
                      ContentTemplate="{DataTemplate views:GastosPage}" />
        <ShellContent Title="Resumen"
                      Route="resumen"
                      ContentTemplate="{DataTemplate views:ResumenPage}" />
    </TabBar>
</Shell>
