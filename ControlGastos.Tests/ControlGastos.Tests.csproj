<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ControlGastos.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ControlGastos\Models\**\*.cs" Link="Fuentes\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ControlGastos\Helpers\**\*.cs" Link="Fuentes\Helpers\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ControlGastos\Services\**\*.cs" Link="Fuentes\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ControlGastos\ViewModels\**\*.cs" Link="Fuentes\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
